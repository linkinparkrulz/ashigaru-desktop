<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import tornadofx.control.Form?>
<?import tornadofx.control.Fieldset?>
<?import tornadofx.control.Field?>
<?import com.sparrowwallet.sparrow.control.UnlabeledToggleSwitch?>

<GridPane hgap="10.0" vgap="14.0" stylesheets="@../general.css, @../gui/ashigaru.css, @preferences.css" styleClass="preferences-detail" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.sparrowwallet.sparrow.preferences.SwapsPreferencesController">
    <padding>
        <Insets left="28.0" right="32.0" top="24.0" bottom="28.0" />
    </padding>
    <columnConstraints>
        <ColumnConstraints percentWidth="100" />
    </columnConstraints>

    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6">
        <Label text="Swaps" styleClass="preferences-section-title" />
        <Label text="Swap Badbank coins for XMR with eigenwallet makers, through Ashigaru's Tor only."
               wrapText="true" minHeight="-Infinity" styleClass="preferences-section-subtitle" />
        <!-- What "experimental" means here, said once and where it cannot be missed -->
        <VBox styleClass="warning-box" spacing="5" maxWidth="Infinity">
            <VBox.margin><Insets top="10"/></VBox.margin>
            <Label text="Experimental" styleClass="warning-title" />
            <Label text="Swaps run on mainnet with real funds. Start with small amounts, and keep Ashigaru open until a swap finishes."
                   wrapText="true" minHeight="-Infinity" styleClass="warning-body" />
        </VBox>
    </VBox>

    <Form GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="preferences-form">
        <Fieldset inputGrow="SOMETIMES" text="Badbank to XMR" styleClass="wideLabelFieldSet">
            <!-- The label sits level with the switch, not halfway down its explanation -->
            <Field text="Enable swaps:" styleClass="field, top-label">
                <VBox spacing="8">
                    <UnlabeledToggleSwitch fx:id="swapsEnabled" />
                    <Label text="Adds Swap to XMR to every wallet's Badbank account, and Swaps to Tools." styleClass="ag-read" wrapText="true" maxWidth="640" minHeight="-Infinity"/>
                    <VBox spacing="4" styleClass="swaps-points">
                        <HBox spacing="8">
                            <Label text="•" styleClass="ag-read, faint" minWidth="-Infinity"/>
                            <Label text="A swap locks one Badbank coin in a shared output with a market maker." styleClass="ag-read, faint" wrapText="true" maxWidth="620" minHeight="-Infinity"/>
                        </HBox>
                        <HBox spacing="8">
                            <Label text="•" styleClass="ag-read, faint" minWidth="-Infinity"/>
                            <Label text="If it does not complete, it can be cancelled after about 5 hours and the BTC refunded to Badbank. Claim the refund within about 24 hours." styleClass="ag-read, faint" wrapText="true" maxWidth="620" minHeight="-Infinity"/>
                        </HBox>
                        <HBox spacing="8">
                            <Label text="•" styleClass="ag-read, faint" minWidth="-Infinity"/>
                            <Label text="Some makers keep part of a refund as an anti-spam deposit. Ashigaru shows this before you approve." styleClass="ag-read, faint" wrapText="true" maxWidth="620" minHeight="-Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Field>
            <Field text="Status:" styleClass="field, top-label">
                <HBox spacing="9" alignment="TOP_LEFT">
                    <Region fx:id="statusDot" styleClass="status-dot">
                        <HBox.margin><Insets top="5"/></HBox.margin>
                    </Region>
                    <Label fx:id="engineStatus" wrapText="true" maxWidth="640" minHeight="-Infinity" styleClass="ag-read" />
                </HBox>
            </Field>
            <Field text="Maximum swap:">
                <TextField fx:id="maxSwap" promptText="0.01" prefWidth="140" maxWidth="140" />
                <Label text="BTC" styleClass="field-label" />
            </Field>
        </Fieldset>
        <Fieldset inputGrow="SOMETIMES" text="Monero nodes" styleClass="wideLabelFieldSet">
            <VBox spacing="6" maxWidth="760">
                <Label wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="ag-read"
                       text="Your BTC is released only once these nodes see the maker's XMR locked, so they are trusted with the swap." />
                <Label wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="ag-read, faint"
                       text="Public nodes are used together: tick at least two, and every one must see the lock. A node you add yourself is trusted on its own: if you tick it, only your node is used and the public ones are ignored." />
            </VBox>
            <VBox fx:id="nodeCard" styleClass="swaps-node-card">
                <VBox.margin><Insets top="12"/></VBox.margin>
                <HBox styleClass="swaps-node-card-header" spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="nodeLockIcon" styleClass="swaps-lock-icon" minWidth="-Infinity" />
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="nodeLockNote" styleClass="ag-read, swaps-lock-note" />
                        <Label fx:id="nodeLockDetail" styleClass="ag-read, faint" wrapText="true" maxWidth="Infinity" minHeight="-Infinity" />
                    </VBox>
                    <Button minWidth="-Infinity" fx:id="checkNodesBtn" text="Check nodes" onAction="#onCheckNodes" styleClass="secondary-btn" />
                    <Button minWidth="-Infinity" fx:id="editNodesBtn" text="Edit nodes" onAction="#onEditNodes" styleClass="secondary-btn" visible="false" managed="false" />
                </HBox>
                <VBox fx:id="nodeList" />
                <HBox fx:id="addNodeRow" styleClass="swaps-node-add" spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="customNode" promptText="your-node.onion:18081" HBox.hgrow="ALWAYS" />
                    <Button minWidth="-Infinity" fx:id="addNodeBtn" text="Add your node" onAction="#onAddNode" styleClass="secondary-btn" />
                </HBox>
            </VBox>
            <Label fx:id="nodeMessage" wrapText="true" minHeight="-Infinity" styleClass="ag-read, faint" visible="false" managed="false">
                <padding><Insets top="6"/></padding>
            </Label>
        </Fieldset>
    </Form>
</GridPane>
