<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparrowwallet.sparrow.gui.AshigaruWalletController"
      styleClass="wallet-panel" spacing="0">

    <!-- ① Account header row: name + action buttons -->
    <HBox styleClass="account-header-row" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
        <Label fx:id="accountNameLabel" text="Deposit" styleClass="account-name-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="receiveBtn" text="⬇  Receive" onAction="#onReceive"
                styleClass="primary-btn" visible="false" managed="false"/>
        <Button minWidth="-Infinity" fx:id="refreshBtn" text="⟳  Refresh" onAction="#onRefresh" styleClass="action-btn refresh-btn"/>
    </HBox>

    <!-- ② Balance row: cards -->
    <HBox styleClass="balance-row" alignment="CENTER_LEFT" spacing="14">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <VBox styleClass="balance-card primary" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="CONFIRMED" styleClass="balance-caption"/>
            <Label fx:id="balanceLabel" text="—" styleClass="balance-value"/>
        </VBox>
        <VBox styleClass="balance-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="MEMPOOL" styleClass="balance-caption"/>
            <Label fx:id="mempoolLabel" text="—" styleClass="balance-value secondary"/>
        </VBox>
        <VBox styleClass="balance-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="UTXOs" styleClass="balance-caption"/>
            <Label fx:id="utxoCountLabel" text="0" styleClass="balance-value secondary"/>
        </VBox>
    </HBox>

    <!-- Badbank / doxxic-change info bar (shown only when Badbank tab is active) -->
    <HBox fx:id="badbankInfoBar" styleClass="badbank-info-bar" alignment="CENTER_LEFT" spacing="8" visible="false" managed="false">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
        <Label text="⚠" styleClass="badbank-warning-icon"/>
        <Label fx:id="badbankInfoLabel"
               text="Spending these UTXOs is not advised. Please consider mixing in a smaller pool or an atomic swap to XMR."
               styleClass="badbank-info-text" wrapText="true"/>
    </HBox>

    <!-- Coordinator-unreachable warning bar (shown while mixing can't connect) -->
    <HBox fx:id="coordinatorWarningBar" styleClass="coordinator-warning-bar" alignment="CENTER_LEFT" spacing="8" visible="false" managed="false">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
        <Label text="⚠" styleClass="coordinator-warning-icon"/>
        <Label text="Can't reach the Whirlpool coordinator. It may be offline — mixing will resume automatically once it's reachable."
               styleClass="coordinator-warning-text" wrapText="true"/>
    </HBox>

    <!-- Syncing bar (shown while the wallet history is refreshing) -->
    <HBox fx:id="syncingBar" styleClass="syncing-bar" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
        <ProgressIndicator styleClass="syncing-spinner" prefWidth="16" prefHeight="16" minWidth="16" minHeight="16"/>
        <Label text="Syncing wallet to the latest block — balances and mixing update once this finishes."
               styleClass="syncing-text" wrapText="true"/>
    </HBox>

    <!-- ③ View toggle: UTXOs / Transactions + Mix Selected (right-aligned) -->
    <HBox styleClass="view-toggle-bar" alignment="CENTER_LEFT" spacing="0">
        <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
        <ToggleButton minWidth="-Infinity" fx:id="utxoViewBtn"  text="UTXOs"        onAction="#onViewToggle" styleClass="view-toggle-btn" selected="true"/>
        <ToggleButton minWidth="-Infinity" fx:id="txnViewBtn"   text="Transactions" onAction="#onViewToggle" styleClass="view-toggle-btn"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="selectAllUtxosBtn" text="Select All UTXOs" onAction="#onSelectAllUtxos"
                styleClass="action-btn" visible="false" managed="false"/>
        <Button minWidth="-Infinity" fx:id="mixSelectedBtn" text="Mix Selected UTXOs" onAction="#onMixSelected"
                styleClass="primary-btn mix-btn" visible="false" managed="false"/>
    </HBox>

    <Separator/>

    <!-- UTXO list — responsive card view -->
    <ListView fx:id="utxoTable" styleClass="utxo-list" VBox.vgrow="ALWAYS">
        <placeholder>
            <VBox alignment="CENTER" spacing="14" styleClass="empty-state">
                <Label text="▼" styleClass="empty-state-icon"/>
                <Label text="You don't have any UTXOs yet" styleClass="empty-state-message"/>
                <Button minWidth="-Infinity" fx:id="receiveCta" text="Receive Funds" onAction="#onReceiveCta"
                        styleClass="primary-btn"/>
            </VBox>
        </placeholder>
    </ListView>

    <!-- Transaction history list (hidden by default) -->
    <ListView fx:id="txnTable" styleClass="utxo-list" VBox.vgrow="ALWAYS" visible="false" managed="false">
        <placeholder>
            <Label text="No transactions" styleClass="table-placeholder"/>
        </placeholder>
    </ListView>

    <Separator/>

    <!-- Mix action buttons: Start Mixing + Mix To (Mix Selected moved to toggle bar above) -->
    <HBox fx:id="mixButtonBox" styleClass="mix-button-row" alignment="CENTER_LEFT" spacing="10" visible="false">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>

        <Button minWidth="-Infinity" fx:id="startMixBtn"  text="Start Mixing" onAction="#onStartMix"  styleClass="primary-btn mix-btn" visible="false"/>
        <Button minWidth="-Infinity" fx:id="mixToBtn"     text="Mix To…"      onAction="#onMixTo"      styleClass="action-btn mix-btn"  visible="false"/>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
