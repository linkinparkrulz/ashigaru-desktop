<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- The page and, over it while the swap asks for a decision, the final review. The review is added by the controller. -->
<StackPane fx:id="swapsRoot" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparrowwallet.sparrow.gui.SwapsToolController"
      stylesheets="@ashigaru.css, @../darktheme.css"
      styleClass="verifier-panel, swaps-panel">
<VBox fx:id="mainView" styleClass="verifier-panel, swaps-panel" spacing="16">
    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

    <HBox spacing="12" alignment="BASELINE_LEFT">
        <Label text="Send BTC  →  Receive XMR" styleClass="swaps-title"/>
        <Label fx:id="engineStatus" wrapText="true" minHeight="-Infinity" styleClass="card-faint" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- The running (or chosen) swap, as the dashboard. While it runs it is all the page shows. The controller fills it. -->
    <VBox fx:id="dashboardBox" spacing="16" visible="false" managed="false"/>

    <!-- Everything else; hidden while a swap runs -->
    <VBox fx:id="offersView" spacing="16">
        <!-- What is being swapped -->
        <GridPane styleClass="ag-card" hgap="16" vgap="10">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>
            <Label text="Spend" styleClass="swaps-stat-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="Expected return" styleClass="swaps-stat-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label fx:id="spendAmount" text="—" styleClass="swaps-amount" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="expectedReturn" text="—" styleClass="swaps-amount" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label fx:id="spendDetail" wrapText="true" minHeight="-Infinity" styleClass="card-faint" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="returnDetail" wrapText="true" minHeight="-Infinity" styleClass="card-faint" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <TextField fx:id="xmrAddressField" promptText="Your XMR address (receives the swap)" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
        </GridPane>

        <!-- Offers -->
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="offersTitle" text="Offers" styleClass="step-title"/>
                    <Label fx:id="marketLine" styleClass="card-faint"/>
                </VBox>
                <Button minWidth="-Infinity" fx:id="refreshBtn" text="Refresh" onAction="#onRefresh" styleClass="secondary-btn"/>
            </HBox>
            <FlowPane fx:id="offerCards" hgap="12" vgap="12"/>
            <Label fx:id="offersEmpty" wrapText="true" minHeight="-Infinity" styleClass="field-label"/>
            <Label fx:id="offersFooter" wrapText="true" minHeight="-Infinity" styleClass="card-faint"/>
            <Label fx:id="messageLabel" wrapText="true" minHeight="-Infinity" styleClass="field-label"/>
        </VBox>

        <!-- Swaps -->
        <VBox spacing="8">
            <Label text="Your swaps" styleClass="step-title"/>
            <TableView fx:id="swapsTable" prefHeight="150" minHeight="100" styleClass="swaps-table">
                <placeholder><Label text="No swaps yet."/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>
</StackPane>
