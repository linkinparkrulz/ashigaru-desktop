<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.glyphfont.Glyph?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparrowwallet.sparrow.gui.SwapController"
      stylesheets="@ashigaru.css, @../darktheme.css"
      styleClass="verifier-panel"
      spacing="16">
    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

    <!-- Hero -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="verifier-hero">
        <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
        <StackPane styleClass="verifier-hero-icon">
            <Glyph fontFamily="Font Awesome 5 Free Solid" fontSize="22" icon="EXCHANGE_ALT" styleClass="verifier-hero-glyph"/>
        </StackPane>
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label fx:id="walletLabel" text="Swap Badbank to XMR" styleClass="verifier-hero-title"/>
            <Label minHeight="-Infinity" wrapText="true" styleClass="verifier-hero-sub"
                   text="Experimental. Swap Badbank BTC for XMR with eigenwallet makers, over Ashigaru's Tor only. Ashigaru asks before signing and again before anything is locked. Keep Ashigaru open until a swap finishes."/>
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" minHeight="-Infinity" wrapText="true" styleClass="field-value"/>

    <!-- Swap -->
    <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
        <Button minWidth="-Infinity" fx:id="refreshBtn" text="Refresh Quotes" onAction="#onRefresh" styleClass="secondary-btn" disable="true"/>
        <ComboBox fx:id="makerCombo" promptText="Maker" prefWidth="420" disable="true"/>
    </FlowPane>
    <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
        <TextField fx:id="amountField" promptText="BTC amount" prefWidth="140" disable="true"/>
        <Label fx:id="balanceLabel" minWidth="-Infinity" styleClass="field-label"/>
        <TextField fx:id="xmrAddressField" promptText="Your XMR address" prefWidth="420" disable="true"/>
        <Button minWidth="-Infinity" fx:id="swapBtn" text="Start Swap" onAction="#onStartSwap" styleClass="primary-btn" disable="true"/>
    </FlowPane>

    <!-- Swaps -->
    <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
        <Button minWidth="-Infinity" fx:id="listSwapsBtn" text="List Swaps" onAction="#onListSwaps" styleClass="secondary-btn" disable="true"/>
        <TextField fx:id="swapIdField" promptText="Swap id" prefWidth="300" disable="true"/>
        <Button minWidth="-Infinity" fx:id="refundBtn" text="Cancel and Refund" onAction="#onRefund" styleClass="secondary-btn" disable="true"/>
    </FlowPane>

    <Label fx:id="messageLabel" minHeight="-Infinity" wrapText="true" styleClass="field-label"/>

    <TextArea fx:id="logArea" editable="false" wrapText="true" styleClass="mono-area" VBox.vgrow="ALWAYS" minHeight="220"/>
</VBox>
