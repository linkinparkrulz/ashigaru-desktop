<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- styleClass lists are comma separated in FXML: "a b" adds ONE class named "a b", which no selector matches -->
<!-- The root is not a ScrollPane: ToolsController already scrolls every tool, and a second scroll layer
     inside it was why this screen jumped and hid its button -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      fx:controller="com.sparrowwallet.sparrow.gui.Bip47MessageVerifierController"
      stylesheets="@ashigaru.css, @../darktheme.css"
      spacing="16" styleClass="verifier-panel, verifier-tool">
    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

    <!-- Hero: a title and one sentence, as on the other Tools pages -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="verifier-hero">
        <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Verify BIP47 Message" styleClass="verifier-hero-title"/>
            <Label minHeight="-Infinity" text="Confirm a Bitcoin message signature matches the notification address derived from a BIP47 payment code."
                   wrapText="true" styleClass="verifier-hero-sub"/>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS" alignment="TOP_LEFT">
        <!-- What to check -->
        <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="420">
            <!-- The payment code the message should come from -->
            <VBox spacing="10" styleClass="ag-card, verifier-step">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Payment code" styleClass="step-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" fx:id="releaseCodeBtn" text="Use Release Signing Code"
                            onAction="#onUseReleaseCode" styleClass="secondary-btn"/>
                </HBox>
                <TextField fx:id="paymentCodeField" promptText="PM8T..." styleClass="address-field"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="payNymHandleField" promptText="Or look one up by +handle" HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" fx:id="payNymLookupBtn" text="Look up" onAction="#onLookupPayNym"
                            styleClass="secondary-btn"/>
                </HBox>
                <Label minHeight="-Infinity" fx:id="payNymLookupStatus" wrapText="true" styleClass="field-label"
                       visible="false" managed="false"/>
            </VBox>

            <!-- The signed message: one paste, read as you paste it -->
            <VBox spacing="10" styleClass="ag-card, verifier-step" VBox.vgrow="ALWAYS">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Signed message" styleClass="step-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" fx:id="pasteBtn" text="Paste" onAction="#onPaste" styleClass="secondary-btn"/>
                    <Button minWidth="-Infinity" fx:id="clearBtn" text="Clear" onAction="#onClear" styleClass="secondary-btn"/>
                </HBox>
                <TextArea fx:id="signedBlockArea" prefRowCount="8" minHeight="150" wrapText="false" VBox.vgrow="ALWAYS"
                          promptText="Paste the whole signed message here, from -----BEGIN BITCOIN SIGNED MESSAGE-----" styleClass="mono-area"/>
                <Label minHeight="-Infinity" fx:id="blockStatus" wrapText="true" styleClass="field-label"/>

                <!-- Only for a message and signature that did not come as a block -->
                <TitledPane fx:id="manualPane" text="Enter the message and signature separately" expanded="false" animated="false"
                            styleClass="verifier-manual">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>
                        <Label text="Message" styleClass="field-label"/>
                        <TextArea fx:id="messageArea" prefRowCount="4" minHeight="80" wrapText="true"
                                  promptText="Message that was signed" styleClass="mono-area"/>
                        <Label text="Base64 signature" styleClass="field-label"/>
                        <TextArea fx:id="signatureArea" prefRowCount="2" minHeight="56" wrapText="true"
                                  promptText="H9..." styleClass="mono-area"/>
                        <Label minHeight="-Infinity" wrapText="true" styleClass="field-label"
                               text="Spaces and line breaks in the message must match exactly what was signed."/>
                    </VBox>
                </TitledPane>
            </VBox>

            <Button minWidth="-Infinity" fx:id="verifyBtn" text="Verify Message" onAction="#onVerify"
                    styleClass="primary-btn, verify-btn" maxWidth="Infinity"/>
        </VBox>

        <!-- The answer stays in view beside the inputs -->
        <VBox fx:id="resultBox" spacing="10" minWidth="320" prefWidth="360" maxWidth="360"
              styleClass="ag-card, verifier-result-box, verifier-result-idle">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="resultIcon" styleClass="verifier-result-icon" minWidth="-Infinity"/>
                <Label fx:id="resultTitleLabel" wrapText="true" minHeight="-Infinity" styleClass="verifier-result-title"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <Label fx:id="resultDetailLabel" wrapText="true" minHeight="-Infinity" styleClass="field-label"/>
            <VBox fx:id="checksBox"/>
        </VBox>
    </HBox>
</VBox>
