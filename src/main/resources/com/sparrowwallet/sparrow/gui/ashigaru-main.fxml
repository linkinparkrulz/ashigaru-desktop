<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sparrowwallet.sparrow.gui.AshigaruMainController"
            styleClass="root-pane">

    <fx:define>
        <ToggleGroup fx:id="accountToggleGroup"/>
    </fx:define>

    <!-- ===== TOP HEADER ===== -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <StackPane styleClass="header-logo-frame">
                <ImageView fitWidth="24" fitHeight="24" preserveRatio="true" smooth="true">
                    <image><Image url="@/image/Ashigaru_Terminal_Logo_Circle.png" requestedWidth="48" requestedHeight="48" preserveRatio="true" smooth="true"/></image>
                </ImageView>
            </StackPane>
            <Label text="Ashigaru" styleClass="app-title"/>
            <Label text="DESKTOP" styleClass="app-title-sub"/>
        </HBox>
    </top>

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <!-- Scrolls rather than clips when the window is shorter than the sidebar, so the window's
             minimum height never has to cover it (a minimum taller than the usable screen stops
             window managers from maximizing or tiling the window). -->
        <ScrollPane styleClass="sidebar-scroll" fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <VBox styleClass="sidebar" minWidth="216" prefWidth="236" spacing="0">

            <!-- ── WALLET SECTION (always visible) ──────────────────── -->
            <VBox styleClass="sidebar-wallet-section" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="CURRENT WALLET" styleClass="sidebar-section-title"/>
                <ComboBox fx:id="walletSelector" styleClass="wallet-selector" maxWidth="Infinity"/>
                <Button fx:id="openWalletBtn" text="Open Wallet…" onAction="#onOpenWallet"
                        maxWidth="Infinity" styleClass="action-btn"/>
                <Button fx:id="createWalletBtn" text="+  New / Restore…" onAction="#onCreateWallet"
                        maxWidth="Infinity" styleClass="primary-btn"/>

                <!-- Secondary, wallet-scoped actions: visually subordinate group.
                     The controller toggles each child's visible/managed individually. -->
                <VBox styleClass="sidebar-manage-group" spacing="4">
                    <Button fx:id="viewSeedBtn" text="View Seed Words…" onAction="#onViewSeed"
                            maxWidth="Infinity" styleClass="manage-btn" visible="false" managed="false"/>
                    <Button fx:id="exportLabelsBtn" text="⬆  Export Labels…" onAction="#onExportLabels"
                            maxWidth="Infinity" styleClass="manage-btn" visible="false" managed="false"/>
                    <Button fx:id="importLabelsBtn" text="⬇  Import Labels…" onAction="#onImportLabels"
                            maxWidth="Infinity" styleClass="manage-btn" visible="false" managed="false"/>
                    <Button fx:id="lockWalletBtn" text="🔒  Lock Wallet" onAction="#onLockWallet"
                            maxWidth="Infinity" styleClass="manage-btn" visible="false" managed="false"/>
                    <Button fx:id="deleteWalletBtn" text="✕  Delete Wallet…" onAction="#onDeleteWallet"
                            maxWidth="Infinity" styleClass="delete-btn" visible="false" managed="false"/>
                </VBox>
            </VBox>

            <Separator/>

            <!-- ── ACCOUNTS SECTION (shown when a wallet is open) ────── -->
            <VBox fx:id="accountButtonsBox" styleClass="sidebar-accounts" spacing="2" visible="false" managed="false">
                <Label text="WALLET ACCOUNTS" styleClass="sidebar-section-title">
                    <padding><Insets top="16" right="14" bottom="8" left="14"/></padding>
                </Label>
                <ToggleButton fx:id="depositBtn"  text="Deposit"  toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="40"
                              onAction="#onAccountSelected"/>
                <ToggleButton fx:id="premixBtn"   text="Premix"   toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="40"
                              onAction="#onAccountSelected"/>
                <ToggleButton fx:id="postmixBtn"  text="Postmix"  toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="40"
                              onAction="#onAccountSelected"/>
                <ToggleButton fx:id="badbankBtn"  text="Badbank"  toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="40"
                              onAction="#onAccountSelected"/>
            </VBox>

            <!-- Spacer fills remaining height -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- ── TOOLS + SETTINGS (always visible, bottom) ─────────── -->
            <Separator/>
            <VBox spacing="6" styleClass="sidebar-actions">
                <padding><Insets top="12" right="14" bottom="14" left="14"/></padding>
                <Button fx:id="toolsBtn" text="⚙  Tools" onAction="#onTools"
                        maxWidth="Infinity" styleClass="nav-btn"/>
                <Button text="⚙  Settings" onAction="#onPreferences"
                        maxWidth="Infinity" styleClass="nav-btn"/>
            </VBox>

        </VBox>
        </ScrollPane>
    </left>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <BorderPane fx:id="contentPane" styleClass="content-area" minHeight="0">
            <center>
                <!-- Welcome placeholder shown before any wallet is opened -->
                <StackPane fx:id="welcomePane" styleClass="welcome-pane">
                    <VBox alignment="CENTER" spacing="20" styleClass="welcome-card" maxWidth="440" maxHeight="320">
                        <padding><Insets top="40" right="44" bottom="40" left="44"/></padding>
                        <StackPane styleClass="welcome-logo-frame">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true" smooth="true">
                                <image><Image url="@/image/Ashigaru_Terminal_Logo_Circle.png" requestedWidth="144" requestedHeight="144" preserveRatio="true" smooth="true"/></image>
                            </ImageView>
                        </StackPane>
                        <VBox alignment="CENTER" spacing="6">
                            <Label text="Welcome to Ashigaru" styleClass="welcome-title"/>
                            <Label text="A privacy-first Bitcoin wallet." styleClass="welcome-sub"/>
                        </VBox>
                        <Label text="Open an existing wallet or create a new one from the sidebar to get started."
                               styleClass="welcome-hint" wrapText="true" maxWidth="320"/>
                    </VBox>
                </StackPane>
            </center>
        </BorderPane>
    </center>

    <!-- ===== BOTTOM STATUS BAR ===== -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="6" right="14" bottom="6" left="14"/></padding>
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="networkLabel" text="MAINNET" styleClass="network-label mainnet"/>
            <Label text="|" styleClass="status-separator"/>
            <Label fx:id="blockHeightLabel" text="Block —" styleClass="status-label"/>
            <Label text="|" styleClass="status-separator"/>
            <Label fx:id="connectionLabel" text="○ Disconnected" styleClass="status-label disconnected connection-toggle" onMouseClicked="#onConnectionLabelClicked"/>
        </HBox>
    </bottom>

</BorderPane>
