<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sparrowwallet.sparrow.gui.AshigaruMainController"
            styleClass="root-pane">

    <fx:define>
        <ToggleGroup fx:id="accountToggleGroup"/>
    </fx:define>

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <!-- Scrolls rather than clips when the window is shorter than the sidebar, so the window's
             minimum height never has to cover it (a minimum taller than the usable screen stops
             window managers from maximizing or tiling the window). -->
        <ScrollPane styleClass="sidebar-scroll" fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <VBox styleClass="sidebar" minWidth="232" prefWidth="252" spacing="0">

            <!-- ── BRAND ────────────────────────────────────────────── -->
            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="16" right="14" bottom="6" left="16"/></padding>
                <StackPane styleClass="header-logo-frame">
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true" smooth="true">
                        <image><Image url="@/image/Ashigaru_Terminal_Logo_Circle.png" requestedWidth="48" requestedHeight="48" preserveRatio="true" smooth="true"/></image>
                    </ImageView>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Ashigaru" styleClass="app-title"/>
                    <Label text="DESKTOP" styleClass="app-title-sub"/>
                </VBox>
            </HBox>

            <!-- ── WALLET CHIP (always visible) ─────────────────────── -->
            <VBox styleClass="sidebar-wallet-section" spacing="8">
                <padding><Insets top="12" right="14" bottom="14" left="14"/></padding>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <ComboBox fx:id="walletSelector" styleClass="wallet-selector" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <!-- Every wallet-scoped action lives here, so the sidebar's one filled button
                         is never "New / Restore" while a wallet is open, and Delete is never a
                         red button next to Lock. -->
                    <MenuButton fx:id="walletMenuBtn" styleClass="wallet-menu-btn" minWidth="34" prefWidth="34"
                                visible="false" managed="false">
                        <items>
                            <MenuItem fx:id="viewSeedBtn" text="View seed words…" onAction="#onViewSeed"/>
                            <MenuItem fx:id="exportLabelsBtn" text="Export labels…" onAction="#onExportLabels"/>
                            <MenuItem fx:id="importLabelsBtn" text="Import labels…" onAction="#onImportLabels"/>
                            <MenuItem fx:id="lockWalletBtn" text="Lock wallet" onAction="#onLockWallet"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="openWalletItem" text="Open another wallet…" onAction="#onOpenWallet"/>
                            <MenuItem fx:id="createWalletItem" text="New / restore…" onAction="#onCreateWallet"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="deleteWalletBtn" text="Delete wallet…" onAction="#onDeleteWallet"/>
                        </items>
                    </MenuButton>
                </HBox>
                <!-- Shown only while no wallet is selected -->
                <VBox fx:id="noWalletBox" spacing="8">
                    <Button fx:id="openWalletBtn" text="Open Wallet…" onAction="#onOpenWallet"
                            maxWidth="Infinity" styleClass="action-btn"/>
                    <Button fx:id="createWalletBtn" text="New / Restore…" onAction="#onCreateWallet"
                            maxWidth="Infinity" styleClass="primary-btn"/>
                </VBox>
            </VBox>

            <!-- ── ACCOUNT PIPELINE (shown when a wallet is open) ────── -->
            <!-- Deposit, Tx0, Premix, mix, Postmix is how the wallet works, so the navigation is
                 drawn as that line. Badbank hangs off it: it is Tx0 change, kept apart. The
                 controller fills each button with its node, name, state and balance. -->
            <VBox fx:id="accountButtonsBox" styleClass="sidebar-accounts" spacing="0" visible="false" managed="false">
                <Label text="ACCOUNTS" styleClass="sidebar-section-title">
                    <padding><Insets top="6" right="14" bottom="8" left="18"/></padding>
                </Label>
                <ToggleButton fx:id="depositBtn"  toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="46"
                              onAction="#onAccountSelected"/>
                <Label text="TX0" styleClass="pipe-connector"/>
                <ToggleButton fx:id="premixBtn"   toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="46"
                              onAction="#onAccountSelected"/>
                <Label text="MIX" styleClass="pipe-connector"/>
                <ToggleButton fx:id="postmixBtn"  toggleGroup="$accountToggleGroup"
                              styleClass="account-btn" maxWidth="Infinity" minHeight="46"
                              onAction="#onAccountSelected"/>
                <Label text="TX0 CHANGE" styleClass="pipe-connector, side">
                    <VBox.margin><Insets top="12"/></VBox.margin>
                </Label>
                <ToggleButton fx:id="badbankBtn"  toggleGroup="$accountToggleGroup"
                              styleClass="account-btn, side" maxWidth="Infinity" minHeight="46"
                              onAction="#onAccountSelected"/>
                <!-- The way out of Badbank, shown when swaps are switched on -->
                <Label fx:id="swapConnector" text="SWAP TO XMR" styleClass="pipe-connector, side, exit" visible="false" managed="false"/>
            </VBox>

            <!-- Spacer fills remaining height -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- ── TOOLS + SETTINGS (always visible, bottom) ─────────── -->
            <Separator/>
            <VBox spacing="2" styleClass="sidebar-actions">
                <padding><Insets top="10" right="14" bottom="12" left="14"/></padding>
                <Button fx:id="toolsBtn" text="Tools" onAction="#onTools"
                        maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="settingsBtn" text="Settings" onAction="#onPreferences"
                        maxWidth="Infinity" styleClass="nav-btn"/>
            </VBox>

        </VBox>
        </ScrollPane>
    </left>

    <!-- ===== CENTER: status strip over the content ===== -->
    <center>
        <BorderPane minHeight="0">
            <top>
                <!-- Connection state is the one thing a Tor wallet should always show, so it sits at
                     the top right as pills rather than in a footer. -->
                <HBox styleClass="status-strip" alignment="CENTER_LEFT" spacing="8" minHeight="46">
                    <padding><Insets top="0" right="20" bottom="0" left="24"/></padding>
                    <Label fx:id="crumbLabel" text="ASHIGARU" styleClass="crumb-label" minWidth="-Infinity"/>
                    <Label fx:id="statusLabel" text="Ready" styleClass="status-label" minWidth="0"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="connectionLabel" text="Offline" minWidth="-Infinity"
                           styleClass="status-pill, disconnected, connection-toggle" onMouseClicked="#onConnectionLabelClicked"/>
                    <Label fx:id="serverLabel" styleClass="status-pill" minWidth="-Infinity" visible="false" managed="false"/>
                    <Label fx:id="blockHeightLabel" text="Block —" styleClass="status-pill" minWidth="-Infinity"/>
                    <Label fx:id="networkLabel" text="MAINNET" styleClass="network-label, mainnet" minWidth="-Infinity"/>
                </HBox>
            </top>
            <center>
                <BorderPane fx:id="contentPane" styleClass="content-area" minHeight="0">
                    <center>
                        <!-- Welcome placeholder shown before any wallet is opened -->
                        <StackPane fx:id="welcomePane" styleClass="welcome-pane">
                            <VBox alignment="CENTER" spacing="20" styleClass="welcome-card" maxWidth="440" maxHeight="320">
                                <padding><Insets top="40" right="44" bottom="40" left="44"/></padding>
                                <StackPane styleClass="welcome-logo-frame">
                                    <ImageView fitWidth="72" fitHeight="72" preserveRatio="true" smooth="true">
                                        <image><Image url="@/image/Ashigaru_Terminal_Logo_Circle.png" requestedWidth="144" requestedHeight="144" preserveRatio="true" smooth="true"/></image>
                                    </ImageView>
                                </StackPane>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label text="Welcome to Ashigaru" styleClass="welcome-title"/>
                                    <Label text="A privacy-first Bitcoin wallet." styleClass="welcome-sub"/>
                                </VBox>
                                <Label text="Open an existing wallet or create a new one from the sidebar to get started."
                                       styleClass="welcome-hint" wrapText="true" maxWidth="320"/>
                            </VBox>
                        </StackPane>
                    </center>
                </BorderPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>
