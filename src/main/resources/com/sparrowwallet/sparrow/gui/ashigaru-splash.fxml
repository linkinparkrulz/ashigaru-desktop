<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.sparrowwallet.sparrow.gui.AshigaruSplashController"
           styleClass="splash-pane" prefWidth="600" prefHeight="400">
    <VBox alignment="CENTER" spacing="20" styleClass="splash-card" maxWidth="440" maxHeight="372">
        <padding>
            <Insets top="28" right="34" bottom="26" left="34" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="18">
            <StackPane styleClass="splash-logo-frame">
                <ImageView fitWidth="88" fitHeight="88" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@/image/Ashigaru_Terminal_Logo_Circle.png" requestedWidth="176" requestedHeight="176" preserveRatio="true" smooth="true"/>
                    </image>
                </ImageView>
            </StackPane>

            <VBox spacing="2" alignment="CENTER_LEFT">
                <Label text="Ashigaru" styleClass="splash-title"/>
                <Label text="Desktop Wallet" styleClass="splash-subtitle"/>
            </VBox>
        </HBox>

        <!-- Startup steps. Each row is driven by the events the app already broadcasts, so the
             splash reports what is actually happening rather than spinning regardless. -->
        <VBox fx:id="stepBox" spacing="5" maxWidth="Infinity">
            <Label fx:id="torStep" styleClass="splash-step" maxWidth="Infinity"/>
            <Label fx:id="serverStep" styleClass="splash-step" maxWidth="Infinity"/>
            <Label fx:id="walletsStep" styleClass="splash-step" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="8" maxWidth="Infinity">
            <Label fx:id="statusLabel" text="Initializing application services" styleClass="splash-status" maxWidth="Infinity" wrapText="true"/>
            <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="-1" styleClass="splash-progress"/>
        </VBox>

        <!-- Shown only when Tor fails to start: a failure needs a way out, not just a message -->
        <HBox fx:id="failureActions" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
            <Button fx:id="openNowBtn" text="Open without waiting" onAction="#onOpenNow" styleClass="action-btn"/>
            <Button fx:id="retryTorBtn" text="Retry Tor" onAction="#onRetryTor" styleClass="primary-btn"/>
        </HBox>
    </VBox>
</StackPane>
