+/// Receives the engine's events and answers its approval requests when the swap library is embedded
+/// in another application instead of eigenwallet's Tauri GUI. Both carry the same JSON the GUI gets.
+#[async_trait]
+pub trait EmbedderSink: Send + Sync {
+    fn emit(&self, event: &str, payload: serde_json::Value);
+
+    /// Returns the approval response, or `None` to reject. Must not approve anything it does not
+    /// understand: an unanswered request is treated as rejected.
+    async fn approve(&self, request: serde_json::Value, timeout_secs: u64) -> Option<serde_json::Value>;
+}
+
