 use std::collections::HashMap;
 
+/// Ashigaru: a peer's addresses with its onion addresses first, otherwise in the order given. With one
+/// dial at a time per peer, a clearnet address tried first could hold a Tor slot until it times out
+/// before the onion address that works is reached.
+pub fn onion_first(mut addresses: Vec<Multiaddr>) -> Vec<Multiaddr> {
+    addresses.sort_by_key(|address| !address.iter().any(|p| matches!(p, Protocol::Onion3(_))));
+    addresses
+}
