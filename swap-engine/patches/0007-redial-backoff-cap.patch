diff --git a/swap-p2p/src/defaults.rs b/swap-p2p/src/defaults.rs
--- a/swap-p2p/src/defaults.rs
+++ b/swap-p2p/src/defaults.rs
@@ -6,8 +6,11 @@ pub const IDLE_CONNECTION_TIMEOUT: Duration = Duration::from_secs(15 * 60); // 1
 pub const BACKOFF_MULTIPLIER: f64 = 1.5;
 
 // Redial
-pub const REDIAL_INITIAL_INTERVAL: Duration = Duration::from_secs(1);
-pub const REDIAL_MAX_INTERVAL: Duration = Duration::from_secs(10);
+/// Ashigaru: half a minute before a rendezvous node is dialled again, and up to ten minutes between attempts at one
+/// that keeps failing (eigenwallet: 1 s and 10 s). Reaching an onion service costs Tor a circuit, and one that asks
+/// for a proof of work costs a core until it is solved.
+pub const REDIAL_INITIAL_INTERVAL: Duration = Duration::from_secs(30);
+pub const REDIAL_MAX_INTERVAL: Duration = Duration::from_secs(10 * 60);
 
 // Rendezvous
 pub const RENDEZVOUS_REDIAL_MAX_INTERVAL: Duration = Duration::from_secs(60);
@@ -24,8 +27,11 @@ pub const RENDEZVOUS_RETRY_MAX_INTERVAL: Duration = Duration::from_secs(60);
 // Quote
 pub const CACHED_QUOTE_EXPIRY: Duration = Duration::from_secs(180);
 pub const QUOTE_INTERVAL: Duration = Duration::from_secs(45);
-pub const QUOTE_REDIAL_INTERVAL: Duration = Duration::from_secs(1);
-pub const QUOTE_REDIAL_MAX_INTERVAL: Duration = Duration::from_secs(30);
+/// Ashigaru: half a minute before a maker is asked again, and up to ten minutes between attempts at one that keeps
+/// failing (eigenwallet: 1 s and 30 s). This is the background round of makers, not the maker a swap is being set up
+/// with, which is dialled directly and is not held back by it.
+pub const QUOTE_REDIAL_INTERVAL: Duration = Duration::from_secs(30);
+pub const QUOTE_REDIAL_MAX_INTERVAL: Duration = Duration::from_secs(10 * 60);
 pub const QUOTE_REQUEST_TIMEOUT: Duration = Duration::from_secs(60);
 
 // Swap setup
diff --git a/swap/src/cli/behaviour.rs b/swap/src/cli/behaviour.rs
--- a/swap/src/cli/behaviour.rs
+++ b/swap/src/cli/behaviour.rs
@@ -19,7 +19,9 @@ pub use swap_p2p::out_event::bob::OutEvent;
 const PROTOCOL_VERSION: &str = "/comit/xmr/btc/1.0.0";
 
 const INITIAL_REDIAL_INTERVAL: Duration = Duration::from_secs(1);
-const MAX_REDIAL_INTERVAL: Duration = Duration::from_secs(30);
+/// Ashigaru: up to ten minutes between attempts at a maker whose swap keeps failing (eigenwallet: 30 s). The peer of a
+/// swap is redialled for as long as the engine runs, and every attempt over Tor costs a circuit.
+const MAX_REDIAL_INTERVAL: Duration = Duration::from_secs(10 * 60);
 
 /// A `NetworkBehaviour` that represents an XMR/BTC swap node as Bob.
 #[derive(NetworkBehaviour)]
