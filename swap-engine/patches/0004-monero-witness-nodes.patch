+
+/// Ashigaru: asks every witness node whether the lock transaction pays the shared address the
+/// agreed amount. A witness that cannot be reached is asked again until it answers, so an outage
+/// stalls the swap (and it is cancelled and refunded at the timelock) rather than skipping the check.
+async fn witnesses_verify_xmr_lock(
+    state: &State3,
+    witnesses: &[Arc<monero::wallet::witness::DaemonWitness>],
+    tx_hash: &monero::TxHash,
+) -> bool {
+    let (public_spend_key, private_view_key) = state.xmr_view_keys();
+    let expected_amount = state.xmr_amount();
+
+    for witness in witnesses {
+        let valid = retry(
+            "Verifying Monero lock transaction with a witness node",
+            || {
+                let witness = witness.clone();
+                let tx_hash = tx_hash.clone();
+                let private_view_key = private_view_key.clone();
+
+                async move {
+                    witness
+                        .verify_transfer(&tx_hash, public_spend_key, private_view_key, expected_amount)
+                        .await
+                        .map_err(backoff::Error::transient)
+                }
+            },
+            None,
+            None,
+        )
+        .await
+        .expect("we never stop retrying to verify with a witness");
+
+        if !valid {
+            tracing::warn!(witness = %witness.url(), txid = %tx_hash, "A witness node does not see the Monero lock transaction paying the agreed amount");
+            return false;
+        }
+    }
+
+    true
+}
+
+/// Ashigaru: waits until every witness node also sees the lock transaction fully confirmed
+async fn witnesses_wait_for_xmr_lock_confirmation(
+    witnesses: &[Arc<monero::wallet::witness::DaemonWitness>],
+    tx_hash: &monero::TxHash,
+    confirmation_target: u64,
+) {
+    for witness in witnesses {
+        let _: () = retry(
+            "Waiting for a witness node to confirm the Monero lock transaction",
+            || {
+                let witness = witness.clone();
+                let tx_hash = tx_hash.clone();
+
+                async move {
+                    witness
+                        .wait_until_confirmed(&tx_hash, confirmation_target)
+                        .await
+                        .map_err(backoff::Error::transient)
+                }
+            },
+            None,
+            None,
+        )
+        .await
+        .expect("we never stop retrying to confirm with a witness");
+    }
+}
