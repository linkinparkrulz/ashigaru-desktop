diff --git a/monero-wallet/src/witness.rs b/monero-wallet/src/witness.rs
new file mode 100644
index 0000000..1d77d0a
--- /dev/null
+++ b/monero-wallet/src/witness.rs
@@ -0,0 +1,91 @@
+//! Ashigaru: a second opinion on the Monero lock transaction.
+//!
+//! The taker only releases its side of a swap once its Monero node says the maker locked the agreed
+//! XMR. A node that lies could make it release the BTC for nothing. A witness is another node asked
+//! the same two questions - does the transaction pay the shared address the agreed amount, and has
+//! it got enough confirmations - and every witness has to agree with the main node.
+use anyhow::{Context, Result};
+use monero_daemon_rpc::MoneroDaemon;
+use monero_simple_request_rpc::SimpleRequestTransport;
+use std::time::Duration;
+use swap_core::monero::primitives::{Amount, PrivateViewKey, TxHash};
+use tokio::sync::OnceCell;
+use zeroize::Zeroizing;
+
+use crate::compat::tx_hash_to_bytes;
+
+const POLL_INTERVAL: Duration = Duration::from_secs(10);
+
+pub struct DaemonWitness {
+    url: String,
+    client: OnceCell<MoneroDaemon<SimpleRequestTransport>>,
+}
+
+impl DaemonWitness {
+    /// `url` is the node's RPC address, e.g. http://127.0.0.1:18081
+    pub fn new(url: String) -> Self {
+        Self {
+            url,
+            client: OnceCell::new(),
+        }
+    }
+
+    pub fn url(&self) -> &str {
+        &self.url
+    }
+
+    async fn rpc_client(&self) -> Result<MoneroDaemon<SimpleRequestTransport>> {
+        self.client
+            .get_or_try_init(|| async {
+                SimpleRequestTransport::new(self.url.clone())
+                    .await
+                    .context("Failed to connect to witness Monero daemon")
+            })
+            .await
+            .cloned()
+    }
+
+    /// The node's chain height, to check it can be reached
+    pub async fn block_height(&self) -> Result<u64> {
+        use monero_daemon_rpc::prelude::ProvidesBlockchainMeta;
+        let rpc_client = self.rpc_client().await?;
+        let height = rpc_client
+            .latest_block_number()
+            .await
+            .with_context(|| format!("Witness {} did not give its block height", self.url))?;
+        Ok(height as u64)
+    }
+
+    /// Same check as [`crate::Wallets::verify_transfer`], against this node
+    pub async fn verify_transfer(
+        &self,
+        tx_hash: &TxHash,
+        public_spend_key: monero_oxide_ext::PublicKey,
+        private_view_key: PrivateViewKey,
+        expected_amount: Amount,
+    ) -> Result<bool> {
+        let rpc_client = self.rpc_client().await?;
+        let tx_id = tx_hash_to_bytes(tx_hash)?;
+
+        monero_wallet_ng::verify::verify_transfer(
+            &rpc_client,
+            tx_id,
+            public_spend_key.decompress(),
+            Zeroizing::new(private_view_key.0.scalar),
+            expected_amount.as_pico(),
+        )
+        .await
+        .with_context(|| format!("Witness {} could not verify the transfer", self.url))
+    }
+
+    /// Same wait as [`crate::Wallets::wait_until_confirmed`], against this node
+    pub async fn wait_until_confirmed(&self, tx_hash: &TxHash, confirmation_target: u64) -> Result<()> {
+        let rpc_client = self.rpc_client().await?;
+        let tx_id = tx_hash_to_bytes(tx_hash)?;
+
+        monero_wallet_ng::confirmations::subscribe(rpc_client, tx_id, POLL_INTERVAL)
+            .wait_until_confirmed(confirmation_target)
+            .await
+            .with_context(|| format!("Witness {} stopped before the transfer confirmed", self.url))
+    }
+}
