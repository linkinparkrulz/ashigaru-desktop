+    pub async fn new_with_socks5(
+        electrum_rpc_urls: &[String],
+        sync_interval: Duration,
+        socks5_proxy: String,
+    ) -> Result<Self> {
+        let config = electrum_pool::ElectrumBalancerConfig {
+            socks5_proxy: Some(socks5_proxy),
+            ..Default::default()
+        };
+        let balancer =
+            ElectrumBalancer::new_with_config(electrum_rpc_urls.to_vec(), config).await?;
+        Self::from_balancer(balancer, sync_interval)
+    }
+
+    fn from_balancer(
+        balancer: ElectrumBalancer,
+        sync_interval: Duration,
+    ) -> Result<Self> {
         let initial_last_sync = Instant::now()
             .checked_sub(sync_interval)
             .ok_or(anyhow!("failed to set last sync time"))?;
